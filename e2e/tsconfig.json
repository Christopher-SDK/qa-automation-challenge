{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": [
      "node",
      "@playwright/test"
    ]
  },
  "include": [
    "pages/**/*.ts",
    "steps/**/*.ts"
  ]
}